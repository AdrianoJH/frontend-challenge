# Ativa a camada de mocks (MSW REST + Socket.IO). "true" em dev/demo/preview.
VITE_ENABLE_MOCKS=true

# Base da API REST. Com mocks ativos é apenas um prefixo interceptado pelo MSW.
VITE_API_URL=/api

# URL do servidor Socket.IO. Interceptado pelo binding MSW quando os mocks estão ativos.
VITE_SOCKET_URL=/

# Cenário inicial dos mocks (ver src/mocks/scenarios.ts): default | empty | slow | flaky | offline
VITE_MOCK_SCENARIO=default
